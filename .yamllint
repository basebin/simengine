---
extends: default
rules:
  line-length:
    max: 120
    level: warning
  empty-values:
    forbid-in-block-mappings: false
    forbid-in-flow-mappings: false
  truthy:
    allowed-values: ['true', 'false', 'on', 'off', 'yes', 'no']
    check-keys: false
  comments:
    require-starting-space: false
    ignore-shebangs: true
  indentation:
    spaces: 2
    indent-sequences: true
    check-multi-line-strings: false
  empty-lines:
    max-start: 1
    max-end: 1
    max: 2
  brackets:
    forbid: false
